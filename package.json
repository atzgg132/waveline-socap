{
  "name": "waveline-socap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/fetch-work.mjs && node scripts/validate-launches.mjs",
    "dev": "vite",
    "build": "node scripts/fetch-work.mjs && node scripts/validate-launches.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-launches.mjs",
    "harness": "node harness/run.mjs --dry-run",
    "harness:offline": "node harness/run.mjs --offline",
    "harness:apply": "node harness/run.mjs --apply",
    "encode-attribution": "node scripts/encode-attribution.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
