# Optional. Copy to `.env` locally. Never commit real values.

# X API v2 Bearer (Developer Portal). Enables tweet metric + media_key refresh.
X_BEARER_TOKEN=

# Product Hunt GraphQL token. Without it the harness fetches the public product HTML.
PRODUCTHUNT_TOKEN=

# Unused unless you pass --youtube-data. oEmbed works with no key.
YOUTUBE_API_KEY=
